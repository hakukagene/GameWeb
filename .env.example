# Optional: copy to .env and run node --env-file=.env server/index.mjs
PORT=8000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:8000
DB_PATH=./data/storyplay.sqlite
NODE_ENV=development
# Demo orders never grant real paid entitlements. Disabled in production.
DEMO_PURCHASES=true
# Separate, same-site origin for Ren'Py development preview. Keep HOST=127.0.0.1 for local use.
GAME_PORT=8001
GAME_ORIGIN=http://localhost:8001
GAME_CONTENT_ROOT=./game-content
# Explicit admin-only preview; production also requires a separate HTTPS game hostname.
ADMIN_GAME_PREVIEW=false
# Only for a local reverse proxy which overwrites X-Real-IP. Requires loopback HOST.
TRUST_PROXY_LOOPBACK=false
